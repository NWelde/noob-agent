# Copy this file to .env. Keep .env local; it is ignored by Git.
# Leave credentials blank until the corresponding integration is enabled.

# W&B identity, Weave tracing, and W&B Serverless Inference all use this key.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=noob-agent
WANDB_BASE_URL=https://api.wandb.ai

# W&B Weave. Keep tracing disabled until an approved tracing adapter exists.
NOOB_AGENT_TRACE_MODE=disabled
WEAVE_DISABLED=true
WEAVE_PRINT_CALL_LINK=false
WEAVE_ENABLE_WAL=false

# W&B Serverless Inference uses WANDB_API_KEY with this OpenAI-compatible URL.
NOOB_AGENT_MODEL_PROVIDER=disabled
NOOB_AGENT_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
NOOB_AGENT_INFERENCE_PROJECT=
NOOB_AGENT_INFERENCE_MODEL=
NOOB_AGENT_ACTION_MAX_OUTPUT_TOKENS=1024
NOOB_AGENT_BUILDER_MAX_OUTPUT_TOKENS=6000
# Provider reasoning per role. Off by default: with it on, reasoning used the whole
# output cap on about half of all Action calls (hackathon_plan.md section 22).
NOOB_AGENT_ACTION_THINKING=false
NOOB_AGENT_BUILDER_THINKING=false

# CoreWeave Sandbox accepts either WANDB_API_KEY or this CoreWeave access token.
# Prefer one credential path; do not set a token unless Sandbox is enabled.
CWSANDBOX_API_KEY=
NOOB_AGENT_SANDBOX_MODE=disabled
NOOB_AGENT_SANDBOX_PLACEMENT=serverless
NOOB_AGENT_SANDBOX_RUNNER_ID=
NOOB_AGENT_SANDBOX_IMAGE=python:3.12-slim
NOOB_AGENT_SANDBOX_MAX_LIFETIME_SECONDS=30

# Local-only paths and runtime behavior.
NOOB_AGENT_DATABASE_URL=sqlite:///./.noob-agent/noob-agent.sqlite
NOOB_AGENT_LOG_LEVEL=INFO
