# Ready-to-run demo settings. Copy to .env and fill in the two marked values:
#
#   cp .env.demo.example .env
#
# .env is ignored by Git. Never commit a real key.
# For the full list of settings, see .env.example.

# 1. Your W&B API key: https://wandb.ai/authorize
WANDB_API_KEY=

# 2. Your W&B entity (username or team) followed by /noob-agent.
#    W&B Inference bills this project, and Weave traces land in it.
NOOB_AGENT_INFERENCE_PROJECT=your-entity/noob-agent

# Nothing below needs to change.
WANDB_PROJECT=noob-agent
WANDB_BASE_URL=https://api.wandb.ai

NOOB_AGENT_MODEL_PROVIDER=wandb-inference
NOOB_AGENT_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
NOOB_AGENT_INFERENCE_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

NOOB_AGENT_TRACE_MODE=weave
WEAVE_DISABLED=false
WEAVE_PRINT_CALL_LINK=false

# Generated skills run in a restricted local subprocess. This is weaker
# isolation than CoreWeave Sandbox, which is not implemented yet.
NOOB_AGENT_SANDBOX_MODE=local
